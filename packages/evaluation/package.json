  },
  "dependencies": {
    "@tkl/contracts": "0.1.0",
    "@tkl/knowledge-store": "0.1.0",
    "@tkl/normalizer-jira": "0.1.0",
    "@tkl/normalizer-github": "0.1.0",
    "@tkl/analyzer-coverage": "0.1.0",
    "@tkl/analyzer-conflicts": "0.1.0"
  },
  "engines": {
    "node": ">=22.6"
  }
}
