{
  "name": "@tkl/evaluation",
  "version": "0.1.0",
  "private": true,
  "description": "Golden dataset and evaluation harness for FL Titling knowledge/traceability quality (Clemente Herrera - Dashboard and Evaluation).",
  "type": "module",
  "main": "src/index.ts",
  "types": "src/index.ts",
  "exports": {
    ".": "./src/index.ts"
  },
  "scripts": {
