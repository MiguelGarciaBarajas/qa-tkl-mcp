{
  "name": "@tkl/core",
  "version": "0.3.0",
  "type": "module",
  "main": "./src/index.js",
  "types": "./src/index.d.ts",
  "exports": {
    ".": {
      "types": "./src/index.d.ts",
      "import": "./src/index.js",
      "default": "./src/index.js"
    },
    "./legacy-jira-queries": {
      "types": "./src/legacy-jira-queries.d.ts",
      "import": "./src/legacy-jira-queries.js",
      "default": "./src/legacy-jira-queries.js"
    }
  },
  "scripts": {
    "build": "node --check src/index.js && node --check src/composition.js && node --check src/legacy-jira-queries.js && tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json",
    "test": "node --experimental-strip-types --test && tsc -p tsconfig.json",
    "test:contract": "node --experimental-strip-types --test && tsc -p tsconfig.json",
    "lint": "node --check src/index.js && node --check src/composition.js && node --check src/legacy-jira-queries.js"
  },
  "dependencies": {
    "@tkl/contracts": "0.1.0",
    "@tkl/knowledge-store": "0.1.0",
    "@tkl/plugin-registry": "0.1.0"
  },
  "engines": {
    "node": ">=22.6"
  }
}
